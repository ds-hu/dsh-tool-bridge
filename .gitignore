node_modules/
# `lib/` is *committed* — the built entry points, not the maps. The profile
# installs this plugin from git, and a git install ships only tracked files: with
# `lib/` ignored, every install got a package whose `main` did not exist and the
# Loader row answered `failed to import`. Rebuild and stage `lib/` with the source
# change (tests/package.spec.ts fails if the entries are missing or untracked).
lib/**/*.map
.pnpm-store/
coverage/
*.tsbuildinfo

# Scratch trees of the engine specs; a crashed or interrupted run can leave one
# behind, and every other one the specs remove themselves.
tests/.tmp-*/

# Local runtime state: per-session toggle state and job logs when a spec or a
# hand-run points the plugin at a directory inside the repository.
.toolbridge/

# Where the browser MCP writes a session's console log and page snapshots
# when it is started in this directory; runtime output, never a source file.
.playwright-mcp/
